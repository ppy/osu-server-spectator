<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>osu.Server.Spectator.PublicAPISchemaExporter</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Docfx.App" Version="2.81.0" />
      <PackageReference Include="Docfx.Plugins" Version="2.81.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
      <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" PrivateAssets="analyzers;build" />
      <PackageReference Include="System.Text.Json" Version="10.0.13" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\osu.Server.Spectator\osu.Server.Spectator.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="docfx.json" CopyToOutputDirectory="Always" />
        <Content Include="*.yml" CopyToOutputDirectory="Always" />
        <Content Include="*.md" CopyToOutputDirectory="Always" />
        <Content Include="logo.png" CopyToOutputDirectory="Always" />
    </ItemGroup>

</Project>
